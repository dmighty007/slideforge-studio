# Copy to .env and fill in values. Real environment variables override this file.

# ---------- Django ----------
# 1 for local development, 0 in production.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Comma-separated hostnames.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- Upload limits (bytes) ----------
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=524288000
# DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=524288000
# PPTMAKER_MAX_ASSET_UPLOAD_BYTES=524288000
# PPTMAKER_MAX_MOLECULE_UPLOAD_BYTES=524288000
# PPTMAKER_MAX_USER_ASSET_STORAGE_BYTES=5242880000

# ---------- LLM providers (all optional) ----------
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# PPTMAKER_API_RETRIES=3

# ---------- Local Ollama ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# PPTMAKER_TEXT_MODEL=
# OLLAMA_VISION_MODEL=
# PPTMAKER_OLLAMA_NUM_CTX=4096
# PPTMAKER_OLLAMA_NUM_PREDICT=800
# PPTMAKER_OLLAMA_TEMPERATURE=0.15
# PPTMAKER_OLLAMA_TOP_P=0.9
# PPTMAKER_VISION_NUM_CTX=2048
# PPTMAKER_VISION_NUM_PREDICT=220
# PPTMAKER_VISION_TEMPERATURE=0.1

# ---------- Document-to-slides pipeline ----------
# PPTMAKER_SLIDE_WRITING_MODE=
# PPTMAKER_SLIDE_WRITERS=1
# PPTMAKER_API_SLIDE_WRITERS=1
# PPTMAKER_LOCAL_SLIDE_WRITERS=1
# PPTMAKER_ENABLE_VISION_ENRICHMENT=1
# PPTMAKER_MAX_VISION_FIGURES=8
# PPTMAKER_ENABLE_AI_CLEANUP=0
# Marker visual extraction (needs requirements-pdf.txt).
# PPTMAKER_USE_MARKER_VISUALS=0
# PPTMAKER_MARKER_TIMEOUT_SECONDS=300
# PPTMAKER_AI_CLEANUP_TIMEOUT_SECONDS=90
# PPTMAKER_FFMPEG_TIMEOUT_SECONDS=900
